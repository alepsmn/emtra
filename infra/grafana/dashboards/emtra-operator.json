          "editorMode": "code",
          "rawSql": "SELECT line_id AS \"Línea\", segment_id AS \"Tramo\", level AS \"Nivel\",\n       round(distance_to_range::numeric, 2) AS \"Distancia\",\n       array_to_string(triggers, ', ') AS \"Disparadores\",\n       to_char(opened_at AT TIME ZONE 'Europe/Madrid', 'HH24:MI') AS \"Apertura\",\n       round(extract(epoch FROM (updated_at - opened_at)) / 60) AS \"Edad (min)\"\nFROM v_open_alerts ORDER BY opened_at DESC"

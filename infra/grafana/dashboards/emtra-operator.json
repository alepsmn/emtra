    {
      "id": 5,
      "type": "table",
      "title": "Salud",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fogstore"
      },
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fogstore"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT service AS \"Servicio\",\n       CASE WHEN updated_at < now() - interval '30 seconds' THEN 'stale' ELSE status END AS \"Estado\",\n       to_char(updated_at AT TIME ZONE 'Europe/Madrid', 'HH24:MI:SS') AS \"Latido\",\n       (metrics->>'snapshots_per_min')::numeric AS \"Inst./min\",\n       (metrics->>'bands_closed')::int AS \"Bandas\",\n       (metrics->>'outbox_depth')::int AS \"Outbox\"\nFROM service_health ORDER BY service"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 50
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "text": "En línea",
                        "color": "#56A877",
                        "index": 0
                      },
                      "stale": {
                        "text": "Sin latido",
                        "color": "#D94F5C",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "else",
                      "result": {
                        "text": "Con error",
                        "color": "#D94F5C",
                        "index": 2
                      }
                    }
                  }
                ]

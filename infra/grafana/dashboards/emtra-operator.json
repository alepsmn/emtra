    {
      "id": 1,
      "type": "status-history",
      "title": "Estado de la red",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fogstore"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fogstore"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT bands.start_at AS time,\n       concat(routes.line_id, ' · T', routes.segment_id) AS metric,\n       coalesce(array_position(ARRAY['A','B','C','D','E','F'], b.los), 0) AS value\nFROM (\n  SELECT line_id, direction_id, segment_id\n  FROM schedule JOIN stops USING (stop_id)\n  GROUP BY line_id, direction_id, segment_id\n  HAVING count(DISTINCT stop_id) >= 3\n) routes\nCROSS JOIN generate_series(\n  time_bucket('15 minutes', $__timeFrom()::timestamptz),\n  $__timeTo()::timestamptz - interval '1 microsecond',\n  interval '15 minutes'\n) AS bands(start_at)\nLEFT JOIN band_status b ON (b.line_id, b.direction_id, b.segment_id, b.band_start)\n                         = (routes.line_id, routes.direction_id, routes.segment_id, bands.start_at)\nORDER BY time, metric"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Sin datos",
                  "color": "#646B76",
                  "index": 0
                },
                "1": {
                  "text": "A",
                  "color": "#56A877",
                  "index": 1
                },
                "2": {
                  "text": "B",
                  "color": "#A3BD63",
                  "index": 2
                },
                "3": {
                  "text": "C",
                  "color": "#E5C352",
                  "index": 3
                },
                "4": {
                  "text": "D",
                  "color": "#F2A353",
                  "index": 4
                },
                "5": {
                  "text": "E",
                  "color": "#E5754C",
                  "index": 5
                },
                "6": {
                  "text": "F",
                  "color": "#D94F5C",
                  "index": 6
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 95,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "showValue": "always",
        "rowHeight": 0.87,
        "colWidth": 0.98,
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "Nivel de servicio por línea y tramo. Cada celda representa una banda de 15 minutos. El gris indica que no hay un LOS disponible."
    },

          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT band_start AS time, concat(line_id, ' · T', segment_id) AS metric, value\nFROM band_status\nWHERE band_start >= $__timeFrom() AND band_start < $__timeTo()\n  AND line_id IN (${line:sqlstring}) AND segment_id IN (${segment:sqlstring})\n  AND indicator = 'cvh'\nORDER BY time, metric"

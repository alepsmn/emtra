    },
    {
      "id": 2,
      "type": "geomap",
      "title": "Mapa",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fogstore"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fogstore"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.stop_id, s.name, s.lat, s.lon, s.segment_id, COALESCE(w.severity, 0) AS severity FROM stops s LEFT JOIN (SELECT segment_id, max(CASE status WHEN 'outside' THEN 3 WHEN 'warning' THEN 2 WHEN 'inside' THEN 1 ELSE 0 END) AS severity FROM v_line_status_latest GROUP BY segment_id) w USING (segment_id) ORDER BY s.stop_sequence"
        }
      ],

        "type": "grafana-postgresql-datasource",
        "uid": "fogstore"
      },
      "description": "c_vh (líneas de alta frecuencia, eje izquierdo; sombreado = rango de referencia) u OTP (baja frecuencia, eje derecho).",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fogstore"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT band_start AS time, value AS cvh FROM band_status WHERE $__timeFilter(band_start) AND line_id = '$line' AND segment_id = $segment AND indicator = 'cvh' ORDER BY 1"

          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT line_id AS \"Línea\", segment_id AS \"Tramo\", level AS \"Nivel\", round(distance_to_range::numeric, 2) AS \"Distancia al rango\", array_to_string(triggers, ', ') AS \"Disparadores\", opened_at AS \"Abierta\", round(extract(epoch FROM (updated_at - opened_at)) / 60) AS \"Antigüedad (min)\" FROM v_open_alerts ORDER BY opened_at DESC"
        }

          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT band_start AS time, value AS otp FROM band_status WHERE $__timeFilter(band_start) AND line_id = '$line' AND segment_id = $segment AND indicator = 'otp' ORDER BY 1"
        }

    {
      "id": 1,
      "type": "table",
      "title": "Estado de la red",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fogstore"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fogstore"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT line_id AS \"Línea\", segment_id AS \"Tramo\", status AS \"Estado\", los AS \"LOS\", indicator AS \"Indicador\", round(value::numeric, 2) AS \"Valor\", n_obs AS \"n\", band_start AS \"Banda\" FROM v_line_status_latest ORDER BY line_id, segment_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "inside": {
                        "text": "dentro",

    {
      "id": 1,
      "type": "status-history",
      "title": "Estado de la red",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fogstore"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fogstore"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT bands.start_at AS time,\n       concat(routes.line_id, ' · T', routes.segment_id) AS metric,\n       coalesce(array_position(ARRAY['A','B','C','D','E','F'], b.los), 0) AS value\nFROM v_line_status_latest routes\nCROSS JOIN generate_series(\n  time_bucket('15 minutes', $__timeFrom()::timestamptz),\n  $__timeTo()::timestamptz - interval '1 microsecond',\n  interval '15 minutes'\n) AS bands(start_at)\nLEFT JOIN band_status b ON (b.line_id, b.direction_id, b.segment_id, b.band_start)\n                         = (routes.line_id, routes.direction_id, routes.segment_id, bands.start_at)\nORDER BY time, metric"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Sin datos",
                  "color": "#646B76",
                  "index": 0
                },
                "1": {
                  "text": "A",
